# ─── Supabase (đã có, dùng cho tags table) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare R2 ───────────────────────────────────────────
# Lấy từ: Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vnexpress-data
# Custom domain hoặc R2 public URL (để trống cho MVP — preview-only commit)
R2_PUBLIC_BASE=
# QUAN TRỌNG: enable Object Versioning trên bucket (Cloudflare dashboard
# → R2 → bucket → Settings → Object Versioning = Enabled). Cần cho
# metadata.yaml field `files[].version_id` (Approach A refined — plan
# synchronous-toasting-kahn.md).

# ─── AI (OpenAI-compatible, default Gemini 2.5 Flash) ────────
# 3 hằng số để swap provider: chỉ đổi BASE_URL + MODEL + ENV_VAR.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
AI_ENV_VAR=GEMINI_API_KEY
# Provider keys (set cái match AI_ENV_VAR):
GEMINI_API_KEY=
ZAI_API_KEY=

# ─── GitHub (commit metadata.yaml + đọc runtime) ────────────
# PAT có scope `repo` (classic) hoặc `contents:write` + `metadata:read` (fine-grained).
# Lấy từ: GitHub → Settings → Developer settings → Personal access tokens.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=anninhn
GITHUB_REPO_NAME=DBVnE-
GITHUB_REPO_BRANCH=main

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Auth (NextAuth v5 — Auth nhẹ) ───────────────────────────
# AUTH_SECRET: signing key cho JWT session. Generate: openssl rand -hex 32
# KHÔNG commit giá trị thật vào git. Rotate = all session invalidated.
AUTH_SECRET=
# AUTH_URL: base URL app. Dev: http://localhost:3000, Prod: https://<domain>
AUTH_URL=http://localhost:3000
