# ─── Supabase (đã có, dùng cho tags table) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare R2 ───────────────────────────────────────────
# Lấy từ: Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vnexpress-data
# Custom domain hoặc R2 public URL (để trống cho MVP — preview-only commit)
R2_PUBLIC_BASE=

# ─── Z.ai (GLM-5.2) ──────────────────────────────────────────
# Lấy từ: https://z.ai/model-api → API Keys → Create API Key
ZAI_API_KEY=

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
